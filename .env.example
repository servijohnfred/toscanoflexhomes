# Copy to .env.local for local testing, and add the same variables in Vercel → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender. Must use a domain verified in Resend (e.g. contact@toscanoflexhomes.com).
CONTACT_FROM_EMAIL=Toscano Flex Homes <contact@toscanoflexhomes.com>

# Where leads are delivered (comma-separated for several).
CONTACT_TO_EMAIL=toscanoflexhomes@gmail.com
